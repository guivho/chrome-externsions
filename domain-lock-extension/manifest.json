{
  "manifest_version": 3,
  "name": "Domain Lock for Tabs",
  "version": "1.4",
  "description": "Beschermt tabs en biedt dynamische tab-switches.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
